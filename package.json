{
  "name": "openremote",
  "packageManager": "yarn@4.17.1",
  "private": true,
  "workspaces": [
    "ui/util",
    "ui/test",
    "ui/app/*",
    "ui/component/*",
    "ui/demo/*"
  ],
  "scripts": {
    "docs": "npx tsc -b ui/component/*/tsconfig.json && npx typedoc --options ui/typedoc.json"
  },
  "devDependencies": {
    "typedoc": "0.28"
  }
}
