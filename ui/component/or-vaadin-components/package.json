{
  "name": "@openremote/or-vaadin-components",
  "version": "1.28.0-snapshot",
  "description": "Vaadin Components packaged as components aligned with the OpenRemote design system",
  "customElements": "build/custom-elements.json",
  "main": "build/dist/umd/index.bundle.js",
  "exports": {
    ".": "./build/lib/index.js",
    "./*": "./build/lib/*.js",
    "./jsx": {
      "types": "./build/custom-elements-jsx.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "*": [
        "build/lib/*"
      ]
    }
  },
  "files": [
    "build/lib/**",
    "build/dist/**",
    "build/custom-elements.json",
    "build/custom-elements-jsx.d.ts"
  ],
  "scripts": {
    "clean": "npx tsc -b --clean && npx shx rm -rf build",
    "analyze": "npx cem analyze --config custom-elements-manifest.config.mjs",
    "build": "npx tsc -b",
    "test": "npx tsc -b && npx playwright test",
    "prepack": "npx tsc -b && npx rspack"
  },
  "author": "OpenRemote",
  "repository": "https://github.com/openremote/openremote",
  "license": "AGPL-3.0-or-later",
  "dependencies": {
    "@openremote/core": "workspace:*",
    "@openremote/model": "workspace:*",
    "@openremote/or-element": "workspace:*",
    "@vaadin/badge": "~25.2.12",
    "@vaadin/button": "~25.2.12",
    "@vaadin/checkbox": "~25.2.12",
    "@vaadin/checkbox-group": "~25.2.12",
    "@vaadin/combo-box": "~25.2.12",
    "@vaadin/confirm-dialog": "~25.2.12",
    "@vaadin/date-picker": "~25.2.12",
    "@vaadin/date-time-picker": "~25.2.12",
    "@vaadin/dialog": "~25.2.12",
    "@vaadin/item": "~25.2.12",
    "@vaadin/list-box": "~25.2.12",
    "@vaadin/menu-bar": "~25.2.12",
    "@vaadin/multi-select-combo-box": "~25.2.12",
    "@vaadin/number-field": "~25.2.12",
    "@vaadin/password-field": "~25.2.12",
    "@vaadin/radio-group": "~25.2.12",
    "@vaadin/select": "~25.2.12",
    "@vaadin/slider": "~25.2.12",
    "@vaadin/text-area": "~25.2.12",
    "@vaadin/text-field": "~25.2.12",
    "@vaadin/time-picker": "~25.2.12",
    "@vaadin/vaadin-themable-mixin": "~25.2.12",
    "lit": "^3.3.1"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@openremote/util": "workspace:*"
  }
}
