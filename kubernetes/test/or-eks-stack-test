#!/usr/bin/env bash

set -Eeuo pipefail

TEST_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KUBERNETES_DIR="$(cd "$TEST_DIR/.." && pwd)"
TEST_TEMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/or-eks-stack-test.XXXXXX")"
CALL_LOG="$TEST_TEMP_DIR/calls.log"
CURL_COUNT_FILE="$TEST_TEMP_DIR/curl-count"
DNS_ENDPOINT_LOG="$TEST_TEMP_DIR/dns-endpoint.json"
CERTIFICATE_DELETED_FILE="$TEST_TEMP_DIR/certificate-deleted"
INGRESS_DELETED_FILE="$TEST_TEMP_DIR/ingress-deleted"
NAMESPACE_DELETED_FILE="$TEST_TEMP_DIR/namespace-deleted"
TEST_CLUSTER_ENDPOINT="https://test-cluster.eks.example.com"
TEST_CERTIFICATE_ARN="arn:aws:acm:eu-west-1:123456789012:certificate/test-certificate"
TEST_SECOND_CERTIFICATE_ARN="arn:aws:acm:eu-west-1:123456789012:certificate/second-certificate"
DEFAULT_CERTIFICATE_JSON='{"Certificate":{"Status":"ISSUED","DomainName":"example.com","SubjectAlternativeNames":["example.com","*.example.com"]}}'
DEFAULT_CERTIFICATE_TAGS='{"Tags":[]}'
DEFAULT_CERTIFICATE_LIST='{"CertificateSummaryList":[]}'
MANAGED_CERTIFICATE_JSON='{"Certificate":{"Status":"PENDING_VALIDATION","DomainName":"stack-a.example.com","SubjectAlternativeNames":["stack-a.example.com"],"DomainValidationOptions":[{"DomainName":"stack-a.example.com","ValidationMethod":"DNS","ResourceRecord":{"Name":"_validation.stack-a.example.com.","Type":"CNAME","Value":"_target.acm-validations.aws."}}]}}'
MANAGED_CERTIFICATE_TAGS='{"Tags":[{"Key":"openremote.io/managed-by","Value":"or-eks-stack"},{"Key":"openremote.io/cluster","Value":"test-cluster"},{"Key":"openremote.io/stack","Value":"stack-a"},{"Key":"openremote.io/hostname","Value":"stack-a.example.com"}]}'
DEFAULT_DNS_ENDPOINT_JSON='{"metadata":{"labels":{"app.kubernetes.io/managed-by":"or-eks-stack","openremote.io/managed-dns":"true"},"annotations":{"openremote.io/certificate-arn":"arn:aws:acm:eu-west-1:123456789012:certificate/test-certificate"}},"spec":{"endpoints":[{"dnsName":"_validation.stack-a.example.com.","recordType":"CNAME","recordTTL":300,"targets":["_target.acm-validations.aws."]}]}}'
DEFAULT_INGRESS_JSON='{"metadata":{"labels":{"openremote.io/managed-dns":"true"},"annotations":{"external-dns.kubernetes.io/hostname":"stack-a.example.com","alb.ingress.kubernetes.io/certificate-arn":"arn:aws:acm:eu-west-1:123456789012:certificate/test-certificate"}},"spec":{"rules":[{"host":"stack-a.example.com"}]}}'
DEFAULT_EXTERNAL_DNS_ARGS=$'--source=service\n--source=ingress\n--source=crd\n--policy=sync\n--registry=txt\n--txt-owner-id=test-cluster-eu-west-1\n--label-filter=openremote.io/managed-dns=true\n--domain-filter=example.com'

cleanup_test() {
  rm -rf "$TEST_TEMP_DIR"
}

trap cleanup_test EXIT

# Source the command so external tools and the portable stack invocation can be
# replaced with deterministic stubs.
source "$KUBERNETES_DIR/or-eks-stack"

fail() {
  printf 'FAIL: %s\n' "$*" >&2
  exit 1
}

log_call() {
  local command="$1"
  shift
  printf '%s' "$command" >> "$CALL_LOG"
  for argument in "$@"; do
    printf '\t%s' "$argument" >> "$CALL_LOG"
  done
  printf '\n' >> "$CALL_LOG"
}

assert_contains() {
  local expected="$1"
  grep -F -- "$expected" "$CALL_LOG" >/dev/null || fail \
    "Expected command log to contain: $expected"
}

assert_not_contains() {
  local unexpected="$1"
  if grep -F -- "$unexpected" "$CALL_LOG" >/dev/null; then
    fail "Expected command log not to contain: $unexpected"
  fi
}

assert_before() {
  local first="$1"
  local first_line
  local second="$2"
  local second_line

  first_line="$(grep -nF -- "$first" "$CALL_LOG" | head -n 1 | cut -d: -f1)"
  second_line="$(grep -nF -- "$second" "$CALL_LOG" | head -n 1 | cut -d: -f1)"
  [ -n "$first_line" ] || fail "Expected command log to contain: $first"
  [ -n "$second_line" ] || fail "Expected command log to contain: $second"
  [ "$first_line" -lt "$second_line" ] || fail \
    "Expected '$first' before '$second'"
}

reset_test() {
  : > "$CALL_LOG"
  : > "$DNS_ENDPOINT_LOG"
  rm -f "$CERTIFICATE_DELETED_FILE" "$INGRESS_DELETED_FILE" \
    "$NAMESPACE_DELETED_FILE"
  printf '0\n' > "$CURL_COUNT_FILE"
  COMMAND=""
  STACK_NAME=""
  CLUSTER_NAME=""
  AWS_REGION_NAME="eu-west-1"
  AWS_PROFILE_NAME=""
  KUBE_CONTEXT=""
  EXPOSURE="haproxy"
  HOSTNAME_VALUE=""
  CERTIFICATE_MODE=""
  CERTIFICATE_ARN=""
  VALUES_DIR=""
  TIMEOUT="20m"
  HTTP_PORT="80"
  HTTPS_PORT="443"
  CONFIRM_STACK_NAME=""
  OR_STACK_COMMAND="$KUBERNETES_DIR/or-stack"
  LOAD_BALANCER_ADDRESS=""
  EXTERNAL_DNS_ARGS=""
  CERTIFICATE_JSON=""
  CERTIFICATE_EXISTS=false
  STACK_NAMESPACE_EXISTS=false
  VALIDATION_DNS_RECORDS=""
  MANAGED_DNS_DOMAIN=""
  AUTHORITATIVE_NAME_SERVERS=""
  STACK_INGRESS_JSON=""
  VALIDATION_DNS_ENDPOINT_EXISTS=false
  MANAGED_CERTIFICATE_DESTROY=false
}

require_command() {
  :
}

aws_eks() {
  log_call aws-eks "$@"
  case " $* " in
    *" cluster.status "*)
      printf '%s\n' "${OR_EKS_STACK_TEST_CLUSTER_STATUS:-ACTIVE}"
      ;;
    *" cluster.endpoint "*)
      printf '%s\n' "$TEST_CLUSTER_ENDPOINT"
      ;;
  esac
}

aws_sts() {
  log_call aws-sts "$@"
  printf '%s\n' "${OR_EKS_STACK_TEST_ACCOUNT_ID:-123456789012}"
}

aws_acm() {
  log_call aws-acm "$@"
  case " $* " in
    *" delete-certificate "*)
      : > "$CERTIFICATE_DELETED_FILE"
      ;;
    *" list-certificates "*)
      printf '%s\n' "${OR_EKS_STACK_TEST_CERTIFICATE_LIST-$DEFAULT_CERTIFICATE_LIST}"
      ;;
    *" request-certificate "*)
      printf '%s\n' "${OR_EKS_STACK_TEST_REQUESTED_CERTIFICATE_ARN:-$TEST_CERTIFICATE_ARN}"
      ;;
    *" list-tags-for-certificate "*)
      printf '%s\n' "${OR_EKS_STACK_TEST_CERTIFICATE_TAGS-$DEFAULT_CERTIFICATE_TAGS}"
      ;;
    *" Certificate.Status "*)
      if [ -f "$CERTIFICATE_DELETED_FILE" ]; then
        printf '%s\n' 'ResourceNotFoundException' >&2
        return 1
      fi
      printf '%s\n' "${OR_EKS_STACK_TEST_CERTIFICATE_STATUS:-ISSUED}"
      ;;
    *" describe-certificate "*)
      if [ -f "$CERTIFICATE_DELETED_FILE" ]; then
        printf '%s\n' 'ResourceNotFoundException' >&2
        return 1
      fi
      printf '%s\n' "${OR_EKS_STACK_TEST_CERTIFICATE_JSON-$DEFAULT_CERTIFICATE_JSON}"
      ;;
  esac
}

helm() {
  log_call helm "$@"
  [ "${OR_EKS_STACK_TEST_EXTERNAL_DNS_HELM_READY:-true}" = "true" ]
}

kubectl() {
  log_call kubectl "$@"
  local arguments=" $* "
  local endpoint_manifest

  case "$arguments" in
    *" get ingressclass openremote-alb "*"shared-certificate-arn"*)
      printf '%s' "${OR_EKS_STACK_TEST_SHARED_CERTIFICATE_ARN-}"
      ;;
    *" config get-contexts "*)
      if [ "${OR_EKS_STACK_TEST_CONTEXT_EXISTS:-true}" = "true" ]; then
        printf '%s\n' "${KUBE_CONTEXT:-test-cluster@eu-west-1}"
      fi
      ;;
    *" config view "*)
      printf '%s' "${OR_EKS_STACK_TEST_CONTEXT_ENDPOINT:-$TEST_CLUSTER_ENDPOINT}"
      ;;
    *" get namespace kube-system "*)
      [ "${OR_EKS_STACK_TEST_CONTEXT_REACHABLE:-true}" = "true" ]
      ;;
    *" get namespace stack-a "*"certificate-mode"*)
      printf '%s' "${OR_EKS_STACK_TEST_RECORDED_CERTIFICATE_MODE:-acme}"
      ;;
    *" get namespace stack-a "*"certificate-arn"*)
      printf '%s' "${OR_EKS_STACK_TEST_RECORDED_CERTIFICATE_ARN:-}"
      ;;
    *" get namespace stack-a "*"openremote.io/hostname"*)
      printf '%s' "${OR_EKS_STACK_TEST_RECORDED_HOSTNAME:-}"
      ;;
    *" get namespace stack-a "*"openremote.io/stack"*)
      if [ "${OR_EKS_STACK_TEST_NAMESPACE_EXISTS:-true}" = "true" ] && \
         [ ! -f "$NAMESPACE_DELETED_FILE" ]; then
        printf 'stack-a|%s' "${OR_EKS_STACK_TEST_NAMESPACE_STACK_LABEL:-stack-a}"
      fi
      ;;
    *" rollout status deployment/openremote-external-dns "*)
      [ "${OR_EKS_STACK_TEST_EXTERNAL_DNS_ROLLOUT_READY:-true}" = "true" ]
      ;;
    *" get deployment openremote-external-dns "*)
      printf '%s\n' "${OR_EKS_STACK_TEST_EXTERNAL_DNS_ARGS-$DEFAULT_EXTERNAL_DNS_ARGS}"
      ;;
    *" get customresourcedefinition/dnsendpoints.externaldns.k8s.io "*)
      if [ "${OR_EKS_STACK_TEST_DNS_ENDPOINT_CRD:-true}" = "true" ]; then
        printf '%s\n' 'customresourcedefinition.apiextensions.k8s.io/dnsendpoints.externaldns.k8s.io'
      else
        return 1
      fi
      ;;
    *" get serviceaccount external-dns "*)
      printf '%s' "${OR_EKS_STACK_TEST_EXTERNAL_DNS_ROLE_ARN-arn:aws:iam::123456789012:role/openremote-external-dns}"
      ;;
    *" get dnsendpoint acm-validation "*)
      if [ -f "$NAMESPACE_DELETED_FILE" ]; then
        return 0
      fi
      if [ "${OR_EKS_STACK_TEST_DNS_ENDPOINT_EXISTS:-false}" != "true" ]; then
        [[ "$arguments" == *" --ignore-not-found "* ]] && return 0
        return 1
      fi
      printf '%s\n' "${OR_EKS_STACK_TEST_DNS_ENDPOINT_JSON-$DEFAULT_DNS_ENDPOINT_JSON}"
      ;;
    *" apply -f - "*)
      IFS= read -r endpoint_manifest
      printf '%s\n' "$endpoint_manifest" > "$DNS_ENDPOINT_LOG"
      ;;
    *" get service proxy "*)
      printf '%s' "${OR_EKS_STACK_TEST_NLB_ADDRESS:-test-nlb.elb.eu-west-1.amazonaws.com}"
      ;;
    *" get ingress proxy "*" -o json "*)
      if [ "${OR_EKS_STACK_TEST_INGRESS_EXISTS:-false}" = "true" ] && \
         [ ! -f "$INGRESS_DELETED_FILE" ] && \
         [ ! -f "$NAMESPACE_DELETED_FILE" ]; then
        printf '%s\n' "${OR_EKS_STACK_TEST_INGRESS_JSON-$DEFAULT_INGRESS_JSON}"
      fi
      ;;
    *" delete ingress proxy "*)
      : > "$INGRESS_DELETED_FILE"
      ;;
    *" get ingress proxy "*)
      printf '%s' "${OR_EKS_STACK_TEST_ALB_ADDRESS:-test-alb.elb.eu-west-1.amazonaws.com}"
      ;;
    *" exec deployment/proxy "*)
      [ "${OR_EKS_STACK_TEST_ACME_SUCCESS:-true}" = "true" ]
      ;;
  esac
}

dig() {
  local argument
  local authoritative=false
  local dns_name=""
  local record_type=""

  log_call dig "$@"
  for argument in "$@"; do
    case "$argument" in
      @*) authoritative=true ;;
      A|AAAA|CNAME|NS) record_type="$argument" ;;
      +*) ;;
      *) dns_name="$argument" ;;
    esac
  done

  if [ "$record_type" = "NS" ]; then
    [ "$dns_name" = "example.com" ] && printf '%s\n' 'ns-1.example.net.'
    return
  fi

  case "$dns_name" in
    stack-a.example.com)
      if [ "$authoritative" = false ] || \
         { [ "${OR_EKS_STACK_TEST_NAMESPACE_EXISTS:-true}" = "true" ] && \
           [ ! -f "$INGRESS_DELETED_FILE" ]; }; then
        printf '%s\n' "${OR_EKS_STACK_TEST_HOST_ADDRESS:-192.0.2.10}"
      fi
      ;;
    _validation.stack-a.example.com|_validation.stack-a.example.com.)
      if [ "${OR_EKS_STACK_TEST_NAMESPACE_EXISTS:-true}" = "true" ] && \
         [ ! -f "$NAMESPACE_DELETED_FILE" ]; then
        printf '%s\n' '_target.acm-validations.aws.'
      fi
      ;;
    test-nlb.elb.eu-west-1.amazonaws.com)
      printf '%s\n' "${OR_EKS_STACK_TEST_NLB_RESOLVED_ADDRESS:-192.0.2.10}"
      ;;
    test-alb.elb.eu-west-1.amazonaws.com)
      printf '%s\n' "${OR_EKS_STACK_TEST_ALB_RESOLVED_ADDRESS:-192.0.2.10}"
      ;;
  esac
}

curl() {
  local curl_count

  log_call curl "$@"
  curl_count="$(< "$CURL_COUNT_FILE")"
  curl_count="$((curl_count + 1))"
  printf '%s\n' "$curl_count" > "$CURL_COUNT_FILE"
  if [ "${OR_EKS_STACK_TEST_HTTPS_READY_IMMEDIATELY:-false}" = "true" ]; then
    return 0
  fi
  [ "$curl_count" -gt 1 ]
}

sleep() {
  :
}

run_or_stack() {
  log_call or-stack "$@"
  if [ "${1:-}" = "destroy" ]; then
    : > "$NAMESPACE_DELETED_FILE"
  fi
}

run_eks_stack() {
  reset_test
  main "$@"
}

test_apply() {
  local output
  local values_dir="$TEST_TEMP_DIR/values"

  mkdir -p "$values_dir"
  output="$(run_eks_stack apply \
    --name stack-a \
    --cluster test-cluster \
    --hostname stack-a.example.com \
    --profile '' \
    --https-port 8443 \
    --values-dir "$values_dir")"

  assert_contains $'aws-eks\tdescribe-cluster\t--name\ttest-cluster\t--query\tcluster.status'
  assert_contains $'kubectl\tconfig\tget-contexts\ttest-cluster@eu-west-1\t-o\tname'
  assert_contains $'aws-eks\tdescribe-cluster\t--name\ttest-cluster\t--query\tcluster.endpoint'
  assert_contains $'kubectl\t--context\ttest-cluster@eu-west-1\tconfig\tview\t--minify'
  assert_contains $'helm\tstatus\topenremote-external-dns\t--kube-context\ttest-cluster@eu-west-1\t--namespace\tkube-system'
  assert_contains $'kubectl\t--context\ttest-cluster@eu-west-1\t--namespace\tkube-system\trollout\tstatus\tdeployment/openremote-external-dns'
  assert_contains $'kubectl\t--context\ttest-cluster@eu-west-1\t--namespace\tkube-system\tget\tserviceaccount\texternal-dns'
  assert_contains $'or-stack\tapply\t--name\tstack-a\t--kube-context\ttest-cluster@eu-west-1\t--target\teks\t--exposure\thaproxy\t--dns\texternal-dns\t--hostname\tstack-a.example.com\t--timeout\t20m\t--http-port\t80\t--https-port\t8443\t--values-dir\t'"$values_dir"
  assert_contains $'kubectl\t--context\ttest-cluster@eu-west-1\tannotate\tnamespace\tstack-a\topenremote.io/certificate-mode=acme\topenremote.io/hostname=stack-a.example.com\t--overwrite'
  assert_contains $'kubectl\t--context\ttest-cluster@eu-west-1\t--namespace\tstack-a\tget\tservice\tproxy'
  assert_contains $'dig\t+short\tstack-a.example.com\tA'
  assert_contains $'dig\t+short\ttest-nlb.elb.eu-west-1.amazonaws.com\tA'
  assert_contains $'kubectl\t--context\ttest-cluster@eu-west-1\t--namespace\tstack-a\texec\tdeployment/proxy\t--container\tproxy\t--\t/entrypoint.sh\tadd\tstack-a.example.com'
  assert_contains $'curl\t--disable\t--fail\t--silent\t--show-error\t--location'
  assert_contains $'--proto\t=https\t--proto-redir\t=https\t--max-redirs\t5'
  assert_contains 'https://stack-a.example.com:8443/manager/'
  assert_before $'helm\tstatus\topenremote-external-dns' $'or-stack\tapply'
  assert_before $'or-stack\tapply' $'get\tservice\tproxy'
  assert_before $'dig\t+short\tstack-a.example.com' $'exec\tdeployment/proxy'
  grep -F -- 'Stack '\''stack-a'\'' is ready at:' <<< "$output" >/dev/null || fail \
    "Apply did not report stack readiness"
  grep -F -- 'https://stack-a.example.com:8443/manager/' <<< "$output" >/dev/null || fail \
    "Apply did not report the canonical Manager URL"
}

test_ingress_existing_certificate_apply() {
  local output

  output="$(run_eks_stack apply \
    --name stack-a \
    --cluster test-cluster \
    --hostname stack-a.example.com \
    --profile '' \
    --exposure ingress \
    --certificate-mode existing \
    --certificate-arn "$TEST_CERTIFICATE_ARN")"

  assert_contains $'aws-sts\tget-caller-identity\t--query\tAccount\t--output\ttext'
  assert_contains $'aws-acm\tdescribe-certificate\t--certificate-arn\t'"$TEST_CERTIFICATE_ARN"$'\t--output\tjson'
  assert_contains $'aws-acm\tlist-tags-for-certificate\t--certificate-arn\t'"$TEST_CERTIFICATE_ARN"$'\t--output\tjson'
  assert_contains $'or-stack\tapply\t--name\tstack-a\t--kube-context\ttest-cluster@eu-west-1\t--target\teks\t--exposure\tingress\t--dns\texternal-dns\t--hostname\tstack-a.example.com\t--timeout\t20m\t--certificate-arn\t'"$TEST_CERTIFICATE_ARN"
  assert_contains $'kubectl\t--context\ttest-cluster@eu-west-1\tannotate\tnamespace\tstack-a\topenremote.io/certificate-mode=existing\topenremote.io/certificate-arn='"$TEST_CERTIFICATE_ARN"$'\topenremote.io/hostname=stack-a.example.com\t--overwrite'
  assert_contains $'kubectl\t--context\ttest-cluster@eu-west-1\t--namespace\tstack-a\tget\tingress\tproxy'
  assert_contains $'dig\t+short\ttest-alb.elb.eu-west-1.amazonaws.com\tA'
  assert_contains 'https://stack-a.example.com/manager/'
  assert_not_contains $'exec\tdeployment/proxy'
  assert_before $'aws-acm\tdescribe-certificate' $'or-stack\tapply'
  assert_before $'or-stack\tapply' $'get\tingress\tproxy'
  grep -F -- "Validated user-owned ACM certificate '$TEST_CERTIFICATE_ARN'" \
    <<< "$output" >/dev/null || fail "Apply did not report ACM validation"
  grep -F -- "The shared ALB is 'test-alb.elb.eu-west-1.amazonaws.com'" \
    <<< "$output" >/dev/null || fail "Apply did not report shared ALB readiness"
}

test_ingress_shared_certificate_apply() {
  local output

  output="$(OR_EKS_STACK_TEST_SHARED_CERTIFICATE_ARN="$TEST_CERTIFICATE_ARN" \
    run_eks_stack apply \
      --name stack-a \
      --cluster test-cluster \
      --hostname stack-a.example.com \
      --profile '' \
      --exposure ingress \
      --certificate-mode shared)"

  assert_contains $'kubectl\t--context\ttest-cluster@eu-west-1\tget\tingressclass\topenremote-alb\t-o\tgo-template={{with index .metadata.annotations "openremote.io/shared-certificate-arn"}}{{.}}{{end}}'
  assert_contains $'aws-acm\tdescribe-certificate\t--certificate-arn\t'"$TEST_CERTIFICATE_ARN"$'\t--output\tjson'
  assert_contains $'or-stack\tapply\t--name\tstack-a\t--kube-context\ttest-cluster@eu-west-1\t--target\teks\t--exposure\tingress\t--dns\texternal-dns\t--hostname\tstack-a.example.com\t--timeout\t20m\t--certificate-arn\t'"$TEST_CERTIFICATE_ARN"
  assert_contains $'kubectl\t--context\ttest-cluster@eu-west-1\tannotate\tnamespace\tstack-a\topenremote.io/certificate-mode=shared\topenremote.io/certificate-arn='"$TEST_CERTIFICATE_ARN"$'\topenremote.io/hostname=stack-a.example.com\t--overwrite'
  assert_before $'get\tingressclass\topenremote-alb' $'aws-acm\tdescribe-certificate'
  assert_before $'aws-acm\tdescribe-certificate' $'or-stack\tapply'
  grep -F -- "Selected the cluster's shared ACM certificate '$TEST_CERTIFICATE_ARN'" \
    <<< "$output" >/dev/null || fail "Apply did not report shared certificate selection"
  grep -F -- "Validated externally managed shared ACM certificate '$TEST_CERTIFICATE_ARN'" \
    <<< "$output" >/dev/null || fail "Apply did not report shared certificate validation"

  OR_EKS_STACK_TEST_SHARED_CERTIFICATE_ARN="$TEST_CERTIFICATE_ARN" \
    run_eks_stack apply \
      --name stack-a \
      --cluster test-cluster \
      --hostname stack-a.example.com \
      --profile '' \
      --exposure ingress >/dev/null
  assert_contains $'openremote.io/certificate-mode=shared'
}

