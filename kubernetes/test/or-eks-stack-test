  assert_contains $'kubectl\t--context\ttest-cluster@eu-west-1\tget\tcustomresourcedefinition/dnsendpoints.externaldns.k8s.io'
  assert_contains $'or-stack\tprepare\t--name\tstack-a\t--kube-context\ttest-cluster@eu-west-1\t--target\teks\t--exposure\tingress\t--dns\texternal-dns'
