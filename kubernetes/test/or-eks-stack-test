  assert_contains $'aws-acm\trequest-certificate\t--domain-name\tstack-a.example.com\t--validation-method\tDNS\t--idempotency-token'
  assert_contains 'Key=openremote.io/managed-by,Value=or-eks-stack'
  assert_contains 'Key=openremote.io/cluster,Value=test-cluster'
  assert_contains 'Key=openremote.io/stack,Value=stack-a'
