test_lifecycle_safety() {
  reset_log
  if OR_STACK_TEST_NAMESPACE_EXISTS=true OR_STACK_TEST_NAMESPACE_LABEL= run_stack apply \
    --name stack-a --kube-context test-context --target local >/dev/null 2>&1; then
    fail "Apply adopted an unlabeled namespace"
  fi
  assert_not_contains $'helm\tupgrade'

  reset_log
  if OR_STACK_TEST_NAMESPACE_EXISTS=true run_stack destroy \
    --name stack-a --kube-context test-context --confirm another-stack >/dev/null 2>&1; then
    fail "Destroy accepted an incorrect confirmation"
  fi
  assert_not_contains $'delete\tnamespace'

  reset_log
  if OR_STACK_TEST_NAMESPACE_EXISTS=true OR_STACK_TEST_NAMESPACE_LABEL= run_stack destroy \
    --name stack-a --kube-context test-context --confirm stack-a >/dev/null 2>&1; then
    fail "Destroy accepted an unlabeled namespace"
  fi
  assert_not_contains $'helm\tuninstall'
  assert_not_contains $'delete\tnamespace'

  reset_log
  if OR_STACK_TEST_NAMESPACE_EXISTS=true OR_STACK_TEST_SECRET_POLICY= run_stack uninstall \
    --name stack-a --kube-context test-context >/dev/null 2>&1; then
    fail "Uninstall accepted a Secret without the keep policy"
  fi
  assert_not_contains $'helm\tuninstall'

  reset_log
  if OR_STACK_TEST_NAMESPACE_EXISTS=true \
    OR_STACK_TEST_PVC_METADATA=$'manager|manager|\npostgresql|postgresql|keep' \
    run_stack uninstall --name stack-a --kube-context test-context >/dev/null 2>&1; then
    fail "Uninstall accepted a chart-managed PVC without the keep policy"
  fi
  assert_not_contains $'helm\tuninstall'

  reset_log
  if OR_STACK_TEST_NAMESPACE_EXISTS=true OR_STACK_TEST_PV_WAIT_SUCCESS=false run_stack destroy \
    --name stack-a --kube-context test-context --confirm stack-a >/dev/null 2>&1; then
    fail "Destroy reported success while PersistentVolume deletion failed"
  fi
  assert_contains $'delete\tnamespace\tstack-a'

  reset_log
  if OR_STACK_TEST_NAMESPACE_EXISTS=true OR_STACK_TEST_SECRET_EXISTS=false run_stack credentials \
    --name stack-a --kube-context test-context >/dev/null 2>&1; then
    fail "Credentials succeeded without the stack Secret"
  fi

  reset_log
  if OR_STACK_TEST_NAMESPACE_EXISTS=true OR_STACK_TEST_NAMESPACE_LABEL= run_stack credentials \
    --name stack-a --kube-context test-context >/dev/null 2>&1; then
    fail "Credentials accepted an unlabeled namespace"
  fi
  assert_not_contains $'get\tsecret\topenremote-secret'

  reset_log
  if OR_STACK_TEST_NAMESPACE_EXISTS=true \
    OR_STACK_TEST_TARGET_LABEL=local \
    OR_STACK_TEST_EXPOSURE_LABEL=ingress \
    run_stack apply --name stack-a --kube-context test-context --target local \
      >/dev/null 2>&1; then
    fail "Apply changed an existing stack's exposure mode"
  fi
  assert_not_contains $'label\tnamespace\tstack-a'
  assert_not_contains $'helm\tupgrade'

  reset_log
  if OR_STACK_TEST_NAMESPACE_EXISTS=true \
    OR_STACK_TEST_TARGET_LABEL=eks \
    OR_STACK_TEST_EXPOSURE_LABEL=haproxy \
    run_stack apply --name stack-a --kube-context test-context --target local \
      >/dev/null 2>&1; then
    fail "Apply changed an existing stack's target"
  fi
  assert_not_contains $'label\tnamespace\tstack-a'
  assert_not_contains $'helm\tupgrade'

  reset_log
  if OR_STACK_TEST_NAMESPACE_EXISTS=true \
    OR_STACK_TEST_TARGET_LABEL= \
    OR_STACK_TEST_EXPOSURE_LABEL= \
    OR_STACK_TEST_MANAGER_INGRESS_EXISTS=true \
    run_stack apply --name stack-a --kube-context test-context --target eks \
      --hostname stack-a.example.com >/dev/null 2>&1; then
    fail "Apply converted an unlabeled legacy ingress stack to HAProxy"
  fi
  assert_not_contains $'label\tnamespace\tstack-a'
  assert_not_contains $'helm\tupgrade'

  reset_log
  OR_STACK_TEST_NAMESPACE_EXISTS=true \
  OR_STACK_TEST_TARGET_LABEL= \
  OR_STACK_TEST_EXPOSURE_LABEL= \
  OR_STACK_TEST_MANAGER_INGRESS_EXISTS=true \
  run_stack apply --name stack-a --kube-context test-context --target eks \
    --exposure ingress \
    --hostname stack-a.example.com \
    --certificate-arn "$TEST_CERTIFICATE_ARN" >/dev/null
  assert_contains $'openremote.io/target=eks'
  assert_contains $'openremote.io/exposure=ingress'
  assert_contains $'helm\tupgrade\t--install\tmanager'
}

test_validation() {
  if run_stack apply --name default --kube-context test-context --target local >/dev/null 2>&1; then
    fail "Reserved namespace was accepted"
  fi

  if run_stack apply --name Stack_A --kube-context test-context --target local >/dev/null 2>&1; then
    fail "Invalid namespace name was accepted"
  fi

  if run_stack apply --name stack-a --kube-context test-context --target unknown >/dev/null 2>&1; then
    fail "Unknown target was accepted"
  fi

  if run_stack apply --name stack-a --kube-context test-context --target local \
    --exposure unknown >/dev/null 2>&1; then
    fail "Unknown exposure was accepted"
  fi

  if run_stack apply --name stack-a --kube-context test-context --target local \
    --hostname 'invalid host' >/dev/null 2>&1; then
    fail "Invalid hostname was accepted"
  fi

  if OR_STACK_TEST_EKS_STORAGE=false run_stack apply \
    --name stack-a --kube-context test-context --target eks \
    --hostname stack-a.example.com >/dev/null 2>&1; then
    fail "EKS target accepted a missing StorageClass"
  fi

  if OR_STACK_TEST_EKS_NETWORK_POLICY=false run_stack apply \
    --name stack-a --kube-context test-context --target eks \
    --hostname stack-a.example.com >/dev/null 2>&1; then
    fail "EKS target accepted disabled NetworkPolicy enforcement"
  fi

  if OR_STACK_TEST_EKS_CNI_CONTAINERS=aws-node run_stack apply \
    --name stack-a --kube-context test-context --target eks \
    --hostname stack-a.example.com >/dev/null 2>&1; then
    fail "EKS target accepted a missing NetworkPolicy agent"
  fi

  if run_stack apply --name stack-a --kube-context test-context --target eks \
    >/dev/null 2>&1; then
    fail "EKS target accepted a missing public hostname"
  fi

  if run_stack apply --name stack-a --kube-context test-context --target eks \
    --exposure ingress --hostname stack-a.example.com >/dev/null 2>&1; then
    fail "EKS ingress exposure accepted a missing ACM certificate ARN"
  fi

  if run_stack apply --name stack-a --kube-context test-context --target eks \
    --exposure ingress --hostname stack-a.example.com \
    --certificate-arn not-an-arn >/dev/null 2>&1; then
    fail "EKS ingress exposure accepted an invalid ACM certificate ARN"
  fi

  if run_stack apply --name stack-a --kube-context test-context --target eks \
    --hostname stack-a.example.com \
    --certificate-arn "$TEST_CERTIFICATE_ARN" >/dev/null 2>&1; then
    fail "HAProxy exposure accepted an ACM certificate ARN"
  fi

  if run_stack apply --name stack-a --kube-context test-context --target local \
    --exposure none --http-port 8080 >/dev/null 2>&1; then
    fail "Non-HAProxy exposure accepted an HTTP port"
  fi

  if run_stack apply --name stack-a --kube-context test-context --target local \
    --http-port 8443 --https-port 8443 >/dev/null 2>&1; then
    fail "HAProxy exposure accepted identical HTTP and HTTPS ports"
  fi

  if OR_STACK_TEST_KUBE_DNS_EXISTS=false run_stack apply \
    --name stack-a --kube-context test-context --target local >/dev/null 2>&1; then
    fail "HAProxy exposure accepted a missing kube-dns Service"
  fi

  if OR_STACK_TEST_EKS_LOAD_BALANCER_CONTROLLER=false run_stack apply \
    --name stack-a --kube-context test-context --target eks \
    --hostname stack-a.example.com >/dev/null 2>&1; then
    fail "Public EKS exposure accepted a missing AWS Load Balancer Controller"
  fi

  if OR_STACK_TEST_EKS_INGRESS_CLASS=false run_stack apply \
    --name stack-a --kube-context test-context --target eks \
    --exposure ingress --hostname stack-a.example.com \
    --certificate-arn "$TEST_CERTIFICATE_ARN" >/dev/null 2>&1; then
    fail "EKS target accepted a missing shared IngressClass"
  fi

  if OR_STACK_TEST_EKS_INGRESS_CLASS_PARAMS=false run_stack apply \
    --name stack-a --kube-context test-context --target eks \
    --exposure ingress --hostname stack-a.example.com \
    --certificate-arn "$TEST_CERTIFICATE_ARN" >/dev/null 2>&1; then
    fail "EKS target accepted missing shared IngressClass parameters"
  fi

  if OR_STACK_TEST_EKS_SSL_REDIRECT_PORT=80 run_stack apply \
    --name stack-a --kube-context test-context --target eks \
    --exposure ingress --hostname stack-a.example.com \
    --certificate-arn "$TEST_CERTIFICATE_ARN" >/dev/null 2>&1; then
    fail "EKS target accepted an IngressClass without HTTPS redirection"
  fi

  OR_STACK_TEST_NAMESPACE_EXISTS=true \
  OR_STACK_TEST_TARGET_LABEL=eks \
