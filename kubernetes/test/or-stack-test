#!/usr/bin/env bash

set -Eeuo pipefail

TEST_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
KUBERNETES_DIR="$(cd "$TEST_DIR/.." && pwd)"
OR_STACK="$KUBERNETES_DIR/or-stack"
TEST_BIN="$TEST_DIR/command-stubs"
TEST_TEMP_DIR="$(mktemp -d "${TMPDIR:-/tmp}/or-stack-test.XXXXXX")"
CALL_LOG="$TEST_TEMP_DIR/calls.log"

cleanup() {
  rm -rf "$TEST_TEMP_DIR"
}

trap cleanup EXIT

fail() {
  printf 'FAIL: %s\n' "$*" >&2
  exit 1
}

assert_contains() {
  local expected="$1"
  grep -F -- "$expected" "$CALL_LOG" >/dev/null || fail \
    "Expected command log to contain: $expected"
}

assert_not_contains() {
  local unexpected="$1"
  if grep -F -- "$unexpected" "$CALL_LOG" >/dev/null; then
    fail "Expected command log not to contain: $unexpected"
  fi
}

assert_before() {
  local first="$1"
  local second="$2"
  local first_line
  local second_line

  first_line="$(grep -nF -- "$first" "$CALL_LOG" | head -n 1 | cut -d: -f1)"
  second_line="$(grep -nF -- "$second" "$CALL_LOG" | head -n 1 | cut -d: -f1)"
  [ -n "$first_line" ] || fail "Expected command log to contain: $first"
  [ -n "$second_line" ] || fail "Expected command log to contain: $second"
  [ "$first_line" -lt "$second_line" ] || fail \
    "Expected '$first' before '$second'"
}

assert_on_line_before() {
  local first="$1"
  local second="$2"
  local line

  line="$(grep -F -- "$first" "$CALL_LOG" | grep -F -- "$second" | head -n 1)"
  [ -n "$line" ] || fail "Expected one command containing '$first' and '$second'"
  case "$line" in
    *"$first"*"$second"*)
      ;;
    *)
      fail "Expected '$first' before '$second' in the same command"
      ;;
  esac
}

reset_log() {
  : > "$CALL_LOG"
}

run_stack() {
  PATH="$TEST_BIN:$PATH" \
    OR_STACK_TEST_LOG="$CALL_LOG" \
    OR_STACK_TEST_CONTEXT="test-context" \
    "$OR_STACK" "$@"
}

test_local_apply() {
  local output
  local values_dir="$TEST_TEMP_DIR/values"
  mkdir -p "$values_dir"
  : > "$values_dir/or-setup.yaml"
  : > "$values_dir/manager.yaml"

  reset_log
  output="$(OR_STACK_TEST_NAMESPACE_EXISTS=false run_stack apply \
    --name stack-a \
    --kube-context test-context \
    --target local \
    --hostname stack-a.localhost \
    --values-dir "$values_dir")"

  assert_contains $'kubectl\t--context\ttest-context\tcreate\tnamespace\tstack-a'
  assert_contains $'kubectl\t--context\ttest-context\tlabel\tnamespace\tstack-a'
  assert_contains $'helm\tupgrade\t--install\tor-setup'
  assert_contains "$KUBERNETES_DIR/stack/targets/local/or-setup.yaml"
  assert_contains "$values_dir/or-setup.yaml"
  assert_on_line_before "$KUBERNETES_DIR/stack/targets/local/or-setup.yaml" "$values_dir/or-setup.yaml"
  assert_contains $'helm\tupgrade\t--install\tpostgresql'
  assert_contains "$KUBERNETES_DIR/stack/targets/local/postgresql.yaml"
  assert_contains $'helm\tupgrade\t--install\tkeycloak'
  assert_contains $'--set-string\tor.hostname=stack-a.localhost'
  assert_contains $'helm\tupgrade\t--install\tmanager'
  assert_contains "$values_dir/manager.yaml"
  assert_not_contains "openremote-ebs"
  assert_not_contains "policyendpoints.networking.k8s.aws"
  grep -F -- "credentials --name stack-a --kube-context test-context" <<< "$output" >/dev/null || fail \
    "Apply output did not explain how to retrieve Manager credentials"
}

test_eks_apply() {
  reset_log
  OR_STACK_TEST_NAMESPACE_EXISTS=true run_stack apply \
    --name stack-eks \
    --kube-context test-context \
    --target eks

  assert_contains $'kubectl\t--context\ttest-context\tget\tstorageclass\topenremote-ebs'
  assert_contains $'kubectl\t--context\ttest-context\tget\tcsidriver\tebs.csi.aws.com'
  assert_contains $'kubectl\t--context\ttest-context\tget\tcustomresourcedefinition/policyendpoints.networking.k8s.aws'
  assert_contains $'kubectl\t--context\ttest-context\t--namespace\tkube-system\tget\tdaemonset\taws-node'
  assert_not_contains $'create\tnamespace\tstack-eks'
  assert_contains "$KUBERNETES_DIR/stack/targets/eks/postgresql.yaml"
  assert_contains "$KUBERNETES_DIR/stack/targets/eks/or-setup.yaml"
  assert_contains "$KUBERNETES_DIR/stack/targets/eks/manager.yaml"
}

test_status() {
  reset_log
  OR_STACK_TEST_NAMESPACE_EXISTS=true run_stack status \
    --name stack-a \
    --kube-context test-context

  assert_contains $'helm\tlist\t--kube-context\ttest-context\t--namespace\tstack-a'
  assert_contains $'kubectl\t--context\ttest-context\t--namespace\tstack-a\tget\tdeployments,statefulsets,pods'
  assert_contains $'kubectl\t--context\ttest-context\t--namespace\tstack-a\tget\tservices,ingresses,networkpolicies'
  assert_contains $'kubectl\t--context\ttest-context\t--namespace\tstack-a\tget\tpersistentvolumeclaims'
}

test_uninstall() {
  reset_log
  OR_STACK_TEST_NAMESPACE_EXISTS=true run_stack uninstall \
    --name stack-a \
    --kube-context test-context

  assert_contains "metadata.name"
  assert_contains "helm\\.sh/resource-policy"
  assert_contains $'helm\tuninstall\tmanager\t--kube-context\ttest-context\t--namespace\tstack-a'
  assert_contains $'helm\tuninstall\tkeycloak\t--kube-context\ttest-context\t--namespace\tstack-a'
  assert_contains $'helm\tuninstall\tpostgresql\t--kube-context\ttest-context\t--namespace\tstack-a'
  assert_contains $'helm\tuninstall\tor-setup\t--kube-context\ttest-context\t--namespace\tstack-a'
  assert_before $'helm\tuninstall\tmanager' $'helm\tuninstall\tkeycloak'
  assert_before $'helm\tuninstall\tkeycloak' $'helm\tuninstall\tpostgresql'
  assert_before $'helm\tuninstall\tpostgresql' $'helm\tuninstall\tor-setup'
  assert_not_contains $'kubectl\t--context\ttest-context\tdelete'
}

test_credentials() {
  local output

  reset_log
  output="$(OR_STACK_TEST_NAMESPACE_EXISTS=true \
    OR_STACK_TEST_ADMIN_PASSWORD=stack-a-password \
    run_stack credentials --name stack-a --kube-context test-context)"

  grep -Fx -- "Manager username: admin" <<< "$output" >/dev/null || fail \
    "Credentials did not show the Manager username"
  grep -Fx -- "Manager password: stack-a-password" <<< "$output" >/dev/null || fail \
    "Credentials did not show the decoded Manager password"
  assert_contains $'kubectl\t--context\ttest-context\t--namespace\tstack-a\tget\tsecret\topenremote-secret'
  assert_not_contains "postgresql-password"
}

test_destroy() {
  reset_log
  OR_STACK_TEST_NAMESPACE_EXISTS=true run_stack destroy \
    --name stack-a \
    --kube-context test-context \
    --confirm stack-a

  assert_contains "spec.volumeName"
  assert_contains $'kubectl\t--context\ttest-context\tdelete\tnamespace\tstack-a'
  assert_contains $'kubectl\t--context\ttest-context\twait\t--for=delete\tpersistentvolume/pvc-manager'
  assert_contains $'kubectl\t--context\ttest-context\twait\t--for=delete\tpersistentvolume/pvc-postgresql'
  assert_before $'helm\tuninstall\tor-setup' $'kubectl\t--context\ttest-context\tdelete\tnamespace\tstack-a'
}

test_lifecycle_safety() {
  reset_log
  if OR_STACK_TEST_NAMESPACE_EXISTS=true OR_STACK_TEST_NAMESPACE_LABEL= run_stack apply \
    --name stack-a --kube-context test-context --target local >/dev/null 2>&1; then
    fail "Apply adopted an unlabeled namespace"
  fi
  assert_not_contains $'helm\tupgrade'

  reset_log
  if OR_STACK_TEST_NAMESPACE_EXISTS=true run_stack destroy \
    --name stack-a --kube-context test-context --confirm another-stack >/dev/null 2>&1; then
    fail "Destroy accepted an incorrect confirmation"
  fi
  assert_not_contains $'delete\tnamespace'

  reset_log
  if OR_STACK_TEST_NAMESPACE_EXISTS=true OR_STACK_TEST_NAMESPACE_LABEL= run_stack destroy \
    --name stack-a --kube-context test-context --confirm stack-a >/dev/null 2>&1; then
    fail "Destroy accepted an unlabeled namespace"
  fi
  assert_not_contains $'helm\tuninstall'
  assert_not_contains $'delete\tnamespace'

  reset_log
  if OR_STACK_TEST_NAMESPACE_EXISTS=true OR_STACK_TEST_SECRET_POLICY= run_stack uninstall \
    --name stack-a --kube-context test-context >/dev/null 2>&1; then
    fail "Uninstall accepted a Secret without the keep policy"
  fi
  assert_not_contains $'helm\tuninstall'

  reset_log
  if OR_STACK_TEST_NAMESPACE_EXISTS=true \
    OR_STACK_TEST_PVC_METADATA=$'manager|manager|\npostgresql|postgresql|keep' \
    run_stack uninstall --name stack-a --kube-context test-context >/dev/null 2>&1; then
    fail "Uninstall accepted a chart-managed PVC without the keep policy"
  fi
  assert_not_contains $'helm\tuninstall'

  reset_log
  if OR_STACK_TEST_NAMESPACE_EXISTS=true OR_STACK_TEST_PV_WAIT_SUCCESS=false run_stack destroy \
    --name stack-a --kube-context test-context --confirm stack-a >/dev/null 2>&1; then
    fail "Destroy reported success while PersistentVolume deletion failed"
  fi
  assert_contains $'delete\tnamespace\tstack-a'

  reset_log
  if OR_STACK_TEST_NAMESPACE_EXISTS=true OR_STACK_TEST_SECRET_EXISTS=false run_stack credentials \
    --name stack-a --kube-context test-context >/dev/null 2>&1; then
    fail "Credentials succeeded without the stack Secret"
  fi

  reset_log
  if OR_STACK_TEST_NAMESPACE_EXISTS=true OR_STACK_TEST_NAMESPACE_LABEL= run_stack credentials \
    --name stack-a --kube-context test-context >/dev/null 2>&1; then
    fail "Credentials accepted an unlabeled namespace"
  fi
  assert_not_contains $'get\tsecret\topenremote-secret'
}

test_validation() {
  if run_stack apply --name default --kube-context test-context --target local >/dev/null 2>&1; then
    fail "Reserved namespace was accepted"
  fi

  if run_stack apply --name Stack_A --kube-context test-context --target local >/dev/null 2>&1; then
    fail "Invalid namespace name was accepted"
  fi

  if run_stack apply --name stack-a --kube-context test-context --target unknown >/dev/null 2>&1; then
    fail "Unknown target was accepted"
  fi

  if run_stack apply --name stack-a --kube-context test-context --target local \
    --hostname 'invalid host' >/dev/null 2>&1; then
    fail "Invalid hostname was accepted"
  fi

  if OR_STACK_TEST_EKS_STORAGE=false run_stack apply \
    --name stack-a --kube-context test-context --target eks >/dev/null 2>&1; then
    fail "EKS target accepted a missing StorageClass"
  fi

  if OR_STACK_TEST_EKS_NETWORK_POLICY=false run_stack apply \
    --name stack-a --kube-context test-context --target eks >/dev/null 2>&1; then
    fail "EKS target accepted disabled NetworkPolicy enforcement"
  fi

  if OR_STACK_TEST_EKS_CNI_CONTAINERS=aws-node run_stack apply \
    --name stack-a --kube-context test-context --target eks >/dev/null 2>&1; then
    fail "EKS target accepted a missing NetworkPolicy agent"
  fi

  OR_STACK_TEST_NAMESPACE_EXISTS=true \
  OR_STACK_TEST_EKS_CNI_CONTAINERS='aws-node aws-network-policy-agent' \
    run_stack apply --name stack-legacy-agent --kube-context test-context --target eks >/dev/null
}

test_local_apply
test_eks_apply
test_status
test_uninstall
test_credentials
test_destroy
test_lifecycle_safety
test_validation

printf 'or-stack tests passed\n'
